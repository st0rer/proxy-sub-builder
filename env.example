# Скопируйте в .env (или в systemd EnvironmentFile) и заполните.
# Все переменные необязательны, кроме отмеченных REQUIRED.

# --- где живёт проект -------------------------------------------------------
PROXY_SUB_HOME=$HOME/.proxy-sub        # cache/, out/, secrets/, scratch/
PROXY_SUB_BIN=$HOME/bin                # sing-box, mihomo, xray-knife

# --- публикация (REQUIRED для publish_pub.py) -------------------------------
GITHUB_REPO=owner/repo                 # репозиторий с подпиской (raw-файлы)
GIST_ID=                               # id гиста, если публикуете и туда
# токен: secrets/gist_token или переменная GITHUB_TOKEN

# --- мобильная проверка (REQUIRED для refresh_yota.sh) ----------------------
PI_HOST=root@pi.local                  # малинка в мобильной сети (ZeroTier/LAN)
PI_PASS=                               # пароль ssh (лучше ключ: PI_KEY)

# --- уведомления ------------------------------------------------------------
# Любая команда, принимающая текст одним аргументом.
# NOTIFY_CMD=hermes send -t telegram
# NOTIFY_CMD=curl -s -d chat_id=123 -d text=

# --- тонкая настройка -------------------------------------------------------
# SUB_MIN_SPEED=0.03                   # МБ/с, мобильный профиль
# SUB_MIN_NODES=3
# BUDGET_MB=12                         # мобильный трафик на прогон
# SPEED_TOP=10
# SCAN_ROUTER=root@192.168.1.1         # для scan_any.py clean
# PY_SCRAPLING=python3                 # интерпретатор со Scrapling
