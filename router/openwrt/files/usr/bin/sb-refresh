#!/bin/sh
# sb-refresh — автономное обновление подписки и генерация конфига sing-box на OpenWrt
set -eu

CONF="sb-client"
CFG_TARGET="/etc/sing-box/config.json"
SCRATCH="/tmp/sb-client"
SRC="$SCRATCH/sub_nodes.txt"
FULL_CFG="$SCRATCH/sb-full.json"
FILTERED_CFG="$SCRATCH/sb-filtered.json"
GEO_FILE="$SCRATCH/sb-geo.json"

mkdir -p "$SCRATCH" /etc/sing-box

log() { echo "[$(date -u +%F' '%T) UTC] [sb-refresh] $*"; }

# Читаем параметры из UCI
SUB_URL=$(uci -q get ${CONF}.main.sub_url || echo "https://raw.githubusercontent.com/st0rer/proxy-sub/main/v2ray.txt")
FALLBACK_URL=$(uci -q get ${CONF}.main.fallback_url || echo "")
EXCLUDE_CC=$(uci -q get ${CONF}.main.exclude_cc || echo "RU")
REQ_GEMINI=$(uci -q get ${CONF}.main.require_gemini || echo "1")
STRICT=$(uci -q get ${CONF}.main.strict_mode || echo "1")
MIN_NODES=$(uci -q get ${CONF}.main.min_nodes || echo "4")
TUN_DEV=$(uci -q get ${CONF}.main.tun_dev || echo "sb0")
TUN_MTU=$(uci -q get ${CONF}.main.tun_mtu || echo "1200")
TUN_ADDR=$(uci -q get ${CONF}.main.tun_addr || echo "172.19.0.1/30")
CF_NODE_FILE=$(uci -q get ${CONF}.main.cf_node_file || echo "/etc/sing-box/cf_node.json")

INITIAL=0
[ "${1:-}" = "--initial" ] && INITIAL=1

log "Начало обновления подписки..."

# 1. Скачивание подписки
DOWNLOAD_OK=0
if curl -sf -m 30 -o "$SRC" "$SUB_URL"; then
	[ -s "$SRC" ] && DOWNLOAD_OK=1
fi

if [ "$DOWNLOAD_OK" -eq 0 ] && [ -n "$FALLBACK_URL" ]; then
	log "Основной URL недоступен, пробую fallback..."
	if curl -sf -m 30 -o "$SRC" "$FALLBACK_URL"; then
		[ -s "$SRC" ] && DOWNLOAD_OK=1
	fi
fi

if [ "$DOWNLOAD_OK" -eq 0 ]; then
	log "ОШИБКА: Не удалось скачать подписку, текущий конфиг не тронут"
	exit 1
fi

# 2. Фаза 1: генерация полного конфига
export SINGBOX_SOURCE="$SRC"
export SINGBOX_CONFIG="$FULL_CFG"
export SINGBOX_CF_NODE="$CF_NODE_FILE"
export SINGBOX_TUN_DEV="$TUN_DEV"
export SINGBOX_TUN_MTU="$TUN_MTU"
export SINGBOX_TUN_ADDR="$TUN_ADDR"

python3 /usr/bin/sbgen.py >/dev/null

if ! sing-box check -c "$FULL_CFG" >/dev/null 2>&1; then
	log "ОШИБКА: Сгенерированный полный конфиг не прошел sing-box check"
	exit 1
fi

# Если это начальный запуск или сервис еще не работает — накатываем сразу
if [ "$INITIAL" -eq 1 ] || ! pgrep -f "sing-box run" >/dev/null 2>&1; then
	log "Начальная установка: применяю полный конфиг..."
	cp "$FULL_CFG" "$CFG_TARGET"
	exit 0
fi

# 3. Фаза 2: замер выхода нод через локальный SOCKS (127.0.0.1:1080) и clash_api (:9090)
log "Замер стран выхода и доступности Gemini по нодам..."

python3 - "$FULL_CFG" "$GEO_FILE" << 'PY'
import json, os, subprocess, sys

full_path = sys.argv[1]
geo_path = sys.argv[2]
cfg = json.load(open(full_path))
nodes = [o for o in cfg.get('outbounds', []) if o.get('server')]
geo = {}

for n in nodes:
    tag = n['tag']
    key = f"{n['type']}|{n['server']}|{n['server_port']}"

    # Переключаем селектор proxy на проверяемую ноду
    sw = subprocess.run(['curl', '-s', '-o', '/dev/null', '-w', '%{http_code}', '-m', '4', '-X', 'PUT',
                         '-H', 'Content-Type: application/json', '-d', json.dumps({'name': tag}),
                         'http://127.0.0.1:9090/proxies/proxy'],
                        capture_output=True, text=True).stdout.strip()
    if sw != '204':
        geo[key] = {'cc': '', 'err': 'switch_failed'}
        continue

    # Замер страны выхода
    body = subprocess.run(['curl', '-s', '-m', '6', '--socks5-hostname', '127.0.0.1:1080',
                           'http://ip-api.com/json/?fields=status,countryCode,isp,query'],
                          capture_output=True, text=True).stdout
    try:
        d = json.loads(body)
        geo[key] = {'cc': (d.get('countryCode') or '').upper(),
                    'isp': d.get('isp') or '', 'ip': d.get('query') or ''}
    except Exception:
        geo[key] = {'cc': '', 'err': 'timeout'}
        continue

    # Замер вердикта Gemini (200 = ок, 403 = гео-блок, 302 на /sorry = датацентровый бот)
    hdr = subprocess.run(['curl', '-s', '-m', '8', '--socks5-hostname', '127.0.0.1:1080',
                          '-D', '-', '-o', '/dev/null', 'https://gemini.google.com/app'],
                         capture_output=True, text=True).stdout
    code, loc = '', ''
    for line in hdr.splitlines():
        if line.startswith('HTTP/'):
            p = line.split()
            if len(p) > 1: code = p[1]
        elif line.lower().startswith('location:'):
            loc = line.split(':', 1)[1].strip()

    geo[key]['gemini'] = 'ok' if code == '200' else ('sorry' if 'sorry' in loc else (code or 'no_resp'))

sw_fail = sum(1 for v in geo.values() if v.get('err') == 'switch_failed')
json.dump(geo, open(geo_path, 'w'), indent=1, ensure_ascii=False)
if sw_fail > max(2, len(nodes) // 3):
    print('ABORT: переключение не удалось для %d из %d нод — на роутере не тот конфиг' % (sw_fail, len(nodes)))
    sys.exit(3)

PY
STATUS=$?
if [ "$STATUS" -ne 0 ]; then
	log "ЗАМЕР ПРЕРВАН (код $STATUS) — публикацию отменяю"
	exit 1
fi

# 4. Фаза 3: генерация отфильтрованного конфига без РФ-выходов и геоблока
log "Генерация отфильтрованного конфига (исключение: $EXCLUDE_CC)..."
ARGS="--geo $GEO_FILE --exclude $EXCLUDE_CC"
[ "$STRICT" -eq 1 ] && ARGS="$ARGS --strict"
[ "$REQ_GEMINI" -eq 1 ] && ARGS="$ARGS --require-gemini"

export SINGBOX_CONFIG="$FILTERED_CFG"
# shellcheck disable=SC2086
python3 /usr/bin/sbgen.py $ARGS >/dev/null

COUNT=$(python3 -c 'import json; c=json.load(open("'$FILTERED_CFG'")); print(sum(1 for o in c.get("outbounds",[]) if o.get("server") and o.get("tag") != "cf"))' 2>/dev/null || echo 0)
log "Живых нод после фильтрации: $COUNT"

if [ "$COUNT" -lt "$MIN_NODES" ]; then
	log "ПРЕДУПРЕЖДЕНИЕ: Слишком мало нод ($COUNT < $MIN_NODES), оставляю прежний конфиг"
	exit 1
fi

if ! sing-box check -c "$FILTERED_CFG" >/dev/null 2>&1; then
	log "ОШИБКА: Отфильтрованный конфиг не валиден"
	exit 1
fi

# 5. Атомарное обновление
mv "$FILTERED_CFG" "$CFG_TARGET"
/etc/init.d/sb-client reload >/dev/null 2>&1 || /etc/init.d/sb-client restart >/dev/null 2>&1
log "Обновление успешно завершено! Конфиг активен."
