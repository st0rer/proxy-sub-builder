#!/bin/sh
# S99singbox-client — Entware init daemon for KeeneticOS 5
ENABLED=yes
PROCS=sing-box
ARGS="run -c /opt/etc/sing-box/config.json"
PREARGS=""
DESC="Sing-Box Subscription Client"
PATH=/opt/sbin:/opt/bin:/usr/sbin:/usr/bin:/sbin:/bin

CONF="/opt/etc/singbox-client/singbox-client.conf"
CRON_FILE="/opt/etc/crontab"

[ -f "$CONF" ] && . "$CONF"

setup_cron() {
	[ -f "$CRON_FILE" ] || touch "$CRON_FILE"
	sed -i '/sb-refresh/d' "$CRON_FILE"
	sed -i '/cf-watchdog/d' "$CRON_FILE"

	if [ "${AUTO_REFRESH:-1}" = "1" ]; then
		echo "${REFRESH_CRON:-17 5 * * *} root /opt/bin/sb-refresh >/dev/null 2>&1" >> "$CRON_FILE"
	fi
	if [ "${CF_WATCHDOG:-1}" = "1" ]; then
		echo "${WATCHDOG_CRON:-*/15 * * * *} root /opt/bin/cf-watchdog >/dev/null 2>&1" >> "$CRON_FILE"
	fi
	if [ -x /opt/etc/init.d/S10cron ]; then
		/opt/etc/init.d/S10cron restart >/dev/null 2>&1 || true
	fi
}

start() {
	echo -n "Starting $DESC: "
	if pgrep -f "$PROCS $ARGS" >/dev/null 2>&1; then
		echo "already running."
		return 0
	fi

	# Если конфига еще нет — первоначальная генерация
	if [ ! -s /opt/etc/sing-box/config.json ]; then
		echo "generating initial config..."
		/opt/bin/sb-refresh --initial || true
	fi

	if [ ! -s /opt/etc/sing-box/config.json ]; then
		echo "FAILED (no config.json)"
		return 1
	fi

	# Валидация
	if ! /opt/bin/sing-box check -c /opt/etc/sing-box/config.json >/dev/null 2>&1; then
		echo "FAILED (config check failed)"
		return 1
	fi

	setup_cron

	# Ограничение памяти и сборка мусора Go runtime для MIPS/ARM (защита от OOM killer)
	export GOMEMLIMIT="${GOMEMLIMIT:-45MiB}"
	export GOGC="${GOGC:-50}"

	# Ротация лога sing-box (держим не более 200 КБ во избежание переполнения диска)
	if [ -f /opt/var/log/sing-box.log ] && [ "$(wc -c < /opt/var/log/sing-box.log 2>/dev/null || echo 0)" -gt 204800 ]; then
		tail -n 500 /opt/var/log/sing-box.log > /opt/var/log/sing-box.log.tmp 2>/dev/null && \
		mv -f /opt/var/log/sing-box.log.tmp /opt/var/log/sing-box.log 2>/dev/null || true
	fi

	# Запуск в фоне
	/opt/bin/sing-box $ARGS >/opt/var/log/sing-box.log 2>&1 &
	sleep 2

	# Применение сетевых хуков
	/opt/etc/ndm/netfilter.d/100-singbox.sh >/dev/null 2>&1 || true

	echo "OK."
}

stop() {
	echo -n "Stopping $DESC: "
	killall sing-box 2>/dev/null || true
	sed -i '/sb-refresh/d' "$CRON_FILE" 2>/dev/null || true
	sed -i '/cf-watchdog/d' "$CRON_FILE" 2>/dev/null || true
	echo "OK."
}

restart() {
	stop
	sleep 1
	start
}

status() {
	if pgrep -f "$PROCS $ARGS" >/dev/null 2>&1; then
		echo "$DESC is running (PID: $(pgrep -f "$PROCS $ARGS" | tr '\n' ' '))"
	else
		echo "$DESC is stopped"
	fi
}

check() {
	/opt/bin/sing-box check -c /opt/etc/sing-box/config.json
}

refresh() {
	/opt/bin/sb-refresh "$@"
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart) restart ;;
	status) status ;;
	check) check ;;
	refresh) refresh ;;
	*) echo "Usage: $0 {start|stop|restart|status|check|refresh}" ; exit 1 ;;
esac
exit 0
