#!/bin/sh
# cf-watchdog — сторож Google-выхода (gcp) для KeeneticOS 5 (Entware)
set -eu

API="http://127.0.0.1:9090"
LOG="/opt/var/log/cf-watchdog.log"
PROBE_URL="https://www.gstatic.com/generate_204"
GCP_SELECTOR="gcp"

log() { echo "[$(date -u +%F' '%T) UTC] $*" >> "$LOG"; }

if ! pgrep -f "sing-box run" >/dev/null 2>&1; then
	exit 0
fi

# Точечный сброс залипших видео-соединений YouTube через Clash API
drop_stalled_video_conns() {
	python3 - <<'PY'
import json, urllib.request, time, sys

API = "http://127.0.0.1:9090"

def get_conns():
    try:
        req = urllib.request.Request(f"{API}/connections")
        with urllib.request.urlopen(req, timeout=3) as resp:
            return json.loads(resp.read().decode()).get("connections", [])
    except Exception:
        return []

def is_video(c):
    host = (c.get("metadata", {}).get("host") or "").lower()
    return "googlevideo.com" in host or "youtube.com" in host

c0 = {c["id"]: c.get("download", 0) for c in get_conns() if is_video(c)}
if not c0:
    sys.exit(0)

time.sleep(2)

c1 = {c["id"]: (c.get("download", 0), c.get("metadata", {}).get("host", "")) for c in get_conns() if is_video(c)}

for cid, (dl1, host) in c1.items():
    if cid in c0:
        dl0 = c0[cid]
        if dl1 == dl0:
            try:
                del_req = urllib.request.Request(f"{API}/connections/{cid}", method="DELETE")
                with urllib.request.urlopen(del_req, timeout=2):
                    pass
                print(f"сброшено залипшее видео-соединение: {cid[:8]} ({host})")
            except Exception:
                pass
PY
}

# 1. Проверяем и точечно сбрасываем залипшие соединения YouTube
drop_stalled_video_conns 2>/dev/null | while IFS= read -r line; do
	[ -n "$line" ] && log "$line"
done

GCP_JSON=$(curl -s -m 4 "$API/proxies/$GCP_SELECTOR" 2>/dev/null || echo "")
if [ -z "$GCP_JSON" ]; then
	exit 0
fi

now=$(python3 -c 'import json,sys
try:
	print(json.loads(sys.argv[1]).get("now", ""))
except Exception:
	pass' "$GCP_JSON" 2>/dev/null || echo "")

candidates=$(python3 -c 'import json,sys
try:
	d = json.loads(sys.argv[1])
	print(" ".join(x for x in d.get("all", []) if x not in ("cf", "auto", "direct")))
except Exception:
	pass' "$GCP_JSON" 2>/dev/null || echo "")

# Гейт Google глазами клиента: 401 на loadCodeAssist (ждёт токен) + 200 на gemini.google.com/app.
# 403 = IP забанен целиком (хостинговые подсети), 400 = геоблок локации. Задержка этого не видит.
gate_probe() {  # печатает "lca gemini"
	lca=$(/opt/bin/curl -s -o /dev/null -w '%{http_code}' -m 8 -X POST \
	      -H 'Content-Type: application/json' -d '{}' --socks5-hostname 127.0.0.1:1080 \
	      https://daily-cloudcode-pa.googleapis.com/v1internal:loadCodeAssist 2>/dev/null)
	g=$(/opt/bin/curl -s -o /dev/null -w '%{http_code}' -m 8 --socks5-hostname 127.0.0.1:1080 \
	    https://gemini.google.com/app 2>/dev/null)
	echo "${lca:-000} ${g:-000}"
}

delay_of() {
	curl -s -m 8 "$API/proxies/$1/delay?timeout=6000&url=$PROBE_URL" 2>/dev/null \
		| python3 -c 'import json,sys
try:
	print(json.load(sys.stdin).get("delay", 0))
except Exception:
	print(0)' 2>/dev/null || echo "0"
}

switch() {
	target="$1"
	code=$(curl -s -o /dev/null -w '%{http_code}' -m 4 -X PUT \
	       -H 'Content-Type: application/json' -d "{\"name\":\"$target\"}" "$API/proxies/$GCP_SELECTOR" 2>/dev/null || echo "000")
	if [ "$code" = "204" ]; then
		log "gcp переключен -> $target (было: $now)"
	else
		log "Ошибка переключения gcp -> $target: HTTP $code"
	fi
}

broken=0
# Нода cf для Google-сервисов непригодна (Cloudflare Workers геоблокируются)
if [ "$now" = "cf" ]; then
	broken=1
	log "gcp стоит на cf (Workers) — немедленная ротация"
fi

# гейт проверяем всегда: узел может быть жив по задержке и при этом забанен Google
gate_ok=0
set -- $(gate_probe)
glca=${1:-000}; ggem=${2:-000}
case "$glca" in
	401|200) [ "$ggem" = "200" ] && gate_ok=1 ;;
esac
if [ "$gate_ok" -eq 0 ]; then
	broken=1
	log "гейт через $now: loadCodeAssist $glca, gemini $ggem — ротация"
fi

if [ "$broken" -eq 0 ]; then
	d=$(delay_of "$now")
	if [ -n "$d" ] && [ "$d" -gt 0 ]; then
		exit 0
	fi
	log "текущий узел $now не отвечает — ротация"
fi

# Кандидата проверяем после переключения на него: гейт меряется с текущего выхода
pick=""
for n in $candidates; do
	[ "$n" = "$now" ] && continue
	d=$(delay_of "$n")
	[ -n "$d" ] && [ "$d" -gt 0 ] || continue
	code=$(curl -s -o /dev/null -w '%{http_code}' -m 4 -X PUT \
	       -H 'Content-Type: application/json' -d "{\"name\":\"$n\"}" "$API/proxies/$GCP_SELECTOR" 2>/dev/null || echo "000")
	[ "$code" = "204" ] || { log "  $n: переключение HTTP $code — пропускаю"; continue; }
	sleep 1
	clca=$(gate_probe); cgem=$(echo "$clca" | cut -d' ' -f2); clca=$(echo "$clca" | cut -d' ' -f1)
	case "$clca" in
		401|200) if [ "$cgem" = "200" ]; then pick="$n"; log "гейт через $n: $clca/$cgem — беру"; break; fi
		         log "  $n: жив, но гейт $clca/$cgem — пропускаю" ;;
		*) log "  $n: жив, но гейт $clca/$cgem — пропускаю" ;;
	esac
done

if [ -n "$pick" ]; then
	switch "$pick"
else
	switch "$now"
	log "нет узлов с проходящим гейтом — оставляю $now"
fi
